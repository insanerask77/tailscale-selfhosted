# =============================================================================
# CONFIGURACIÓN HEADSCALE + HEADPLANE
# =============================================================================
# Este archivo muestra todas las variables de configuración disponibles.
# El instalador install.sh generará un .env con valores personalizados.

# -----------------------------------------------------------------------------
# MODO DE DESPLIEGUE
# -----------------------------------------------------------------------------
# Determina quién termina TLS, si arranca Caddy y si hay uno o dos dominios.
#
#   standalone    Caddy embebido enruta un solo dominio: / -> Headscale,
#                 /admin -> Headplane. El certificado lo decide SSL_MODE y
#                 puede ser ninguno (SSL_MODE=none -> Caddy sirve por HTTP).
#   proxy-single  Un proxy externo (Nginx Proxy Manager, Traefik...) termina
#                 TLS. Un dominio: / -> Headscale, /admin -> Headplane.
#   proxy-split   Proxy externo con dominios separados para el control plane
#                 y la UI. Requiere cabeceras CORS en el proxy.
#   plain         HTTP sin cifrar, puertos publicados directamente.
#                 Sólo LAN de confianza y desarrollo.
DEPLOY_MODE=standalone

# -----------------------------------------------------------------------------
# RED Y ACCESO
# -----------------------------------------------------------------------------

# Dominio o IP para acceder al servicio (sin esquema ni puerto)
# Ejemplos: vpn.midominio.com, 192.168.1.100, 10.0.0.5
DOMAIN=vpn.example.com

# Dominios por servicio. En todos los modos salvo proxy-split coinciden
# entre sí y con DOMAIN; en proxy-split deben ser distintos.
HEADSCALE_DOMAIN=vpn.example.com
HEADPLANE_DOMAIN=vpn.example.com

# Esquema de las URLs públicas (http o https). Derivado de DEPLOY_MODE y,
# en standalone, de SSL_MODE: https en proxy-*, http en plain y en
# standalone con SSL_MODE=none.
URL_SCHEME=https

# URL del control plane: la que usan los clientes con --login-server.
# Con TLS (Caddy o proxy externo) NO lleva puerto: se enruta por dominio/ruta.
# En modo plain DEBE incluir HEADSCALE_HTTP_PORT, porque Headscale se expone ahí.
#   standalone / proxy-*:  https://vpn.example.com
#   plain:                 http://vpn.example.com:8080
SERVER_URL=https://vpn.example.com
HEADSCALE_PUBLIC_URL=https://vpn.example.com

# URL pública de la interfaz web. La UI se sirve SIEMPRE bajo /admin
# (el prefijo está compilado en la imagen de Headplane).
#   standalone / proxy-single:  https://vpn.example.com          -> UI en /admin
#   proxy-split:                https://admin.vpn.example.com    -> UI en /admin
#   plain:                      http://vpn.example.com:3000      -> UI en :3000/admin
HEADPLANE_PUBLIC_URL=https://vpn.example.com

# ¡Ojo con el nombre! ENABLE_SSL significa "arrancar el contenedor Caddy"
# (activa el profile 'ssl' de docker-compose), NO "hay HTTPS": en los modos
# proxy-* hay HTTPS pero lo termina el proxy externo y Caddy no debe arrancar.
# Sólo es true en modo standalone.
ENABLE_SSL=true

# Origen del certificado. En standalone es una elección de tres; en el resto
# de modos lo fija el propio DEPLOY_MODE.
# - letsencrypt: certificado automático de Caddy (requiere dominio con DNS público)
# - selfsigned:  CA interna de Caddy; hay que instalarla en cada cliente Tailscale
# - external:    lo emite el proxy externo (modos proxy-*)
# - none:        sin TLS. En standalone Caddy sigue arrancando y enrutando
#                / y /admin, sólo que por HTTP (p.ej. http://localhost) y
#                escuchando únicamente en HTTP_PORT. En modo plain no hay
#                ni Caddy ni TLS.
SSL_MODE=letsencrypt

# Email para Let's Encrypt (solo si SSL_MODE=letsencrypt)
ACME_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# PROXY EXTERNO (modos proxy-single, proxy-split y plain)
# -----------------------------------------------------------------------------

# Interfaz del host donde se publican los puertos cuando Caddy no arranca.
# 0.0.0.0 los deja accesibles desde toda la red; pon la IP de esta máquina en
# la red del proxy para limitar la exposición. Van SIN cifrar: usa firewall.
BIND_ADDRESS=0.0.0.0

# CIDR del reverse proxy externo. Se escribe en trusted_proxies de Headscale
# para que confíe en su X-Forwarded-For y registre la IP real del cliente.
# Sin esto, todos los nodos aparecen con la IP del proxy en los logs.
# Headscale rechaza el prefijo /0. Ejemplos: 192.168.1.50/32, 192.168.1.0/24
PROXY_CIDR=

# Dirección de ESTA máquina tal como la ve el proxy: es el destino al que el
# reverse proxy reenvía. Se usa para generar reverse-proxy/*.conf.
BACKEND_HOST=

# -----------------------------------------------------------------------------
# PUERTOS
# -----------------------------------------------------------------------------

# Puerto HTTP del proxy Caddy (solo en modo standalone). Con SSL_MODE=none es
# el único puerto que se publica; con certificado sólo sirve para el reto ACME
# y la redirección a HTTPS.
HTTP_PORT=80

# Puerto HTTPS del proxy Caddy (solo en modo standalone). Se ignora si
# SSL_MODE=none: sin certificado Caddy no escucha en 443 y no se publica.
HTTPS_PORT=443

# Puerto web de Headplane (interno en standalone; publicado en el resto de modos)
HEADPLANE_PORT=3000

# Puerto gRPC de Headscale (interno, no necesita exponerse externamente)
HEADSCALE_GRPC_PORT=50443

# Puerto HTTP API de Headscale
# (interno en standalone; publicado y proxificado en los modos proxy-*)
HEADSCALE_HTTP_PORT=8080

# Puerto DERP/STUN de Headscale (UDP, debe ser accesible externamente).
# NINGÚN reverse proxy HTTP puede transportarlo: ábrelo directo contra esta
# máquina, o desactiva derp.server.enabled y usa los relays de Tailscale.
HEADSCALE_DERP_PORT=3478

# Puerto Metrics de Headscale (interno, opcional)
HEADSCALE_METRICS_PORT=9090

# -----------------------------------------------------------------------------
# HEADSCALE - CONFIGURACIÓN DE LA RED TAILNET
# -----------------------------------------------------------------------------

# Nombre de la organización/tailnet (alfanumérico, sin espacios)
TAILNET_NAME=myorg

# Usuario administrador creado automáticamente durante el despliegue
ADMIN_USER=admin

# Caducidad de la API key generada automáticamente (ej: 90d, 365d)
APIKEY_EXPIRATION=90d

# API key de Headscale. La genera install.sh tras arrancar Headscale y es la
# credencial con la que se inicia sesión en Headplane (si no usas OIDC).
# NUNCA la rellenes aquí a mano ni la subas al repositorio.
HEADSCALE_API_KEY=

# Dirección de red IPv4 para los clientes (CIDR)
IP_PREFIXES_V4=100.64.0.0/10

# Dirección de red IPv6 para los clientes (CIDR, opcional)
IP_PREFIXES_V6=fd7a:115c:a1e0::/48

# Ruta de persistencia de datos (SQLite y archivos)
DATA_DIR=./data

# Nivel de log: trace, debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# HEADPLANE - CONFIGURACIÓN DE LA UI
# -----------------------------------------------------------------------------

# Secreto para cookies (generado automáticamente, 64 caracteres hex)
# NUNCA compartas este valor, regenerarlo invalida todas las sesiones
COOKIE_SECRET=

# Modo de integración con Headscale:
# - integrated: acceso directo al socket Unix de Headscale (recomendado)
# - api: acceso vía API HTTP (requiere configurar API key)
INTEGRATION_MODE=integrated

# -----------------------------------------------------------------------------
# AUTENTICACIÓN OIDC (OPCIONAL)
# -----------------------------------------------------------------------------

# ¿Habilitar autenticación OIDC? (true/false)
# Si es false, Headplane usa autenticación local (usuario/contraseña)
ENABLE_OIDC=false

# Issuer URL del proveedor OIDC (ej: https://auth.example.com/realms/master)
OIDC_ISSUER_URL=

# Client ID de la aplicación registrada en el proveedor OIDC
OIDC_CLIENT_ID=

# Client Secret de la aplicación
OIDC_CLIENT_SECRET=

# Scopes OIDC a solicitar (separados por espacios)
OIDC_SCOPE=openid profile email

# Claim que contiene el email del usuario
OIDC_EMAIL_CLAIM=email

# -----------------------------------------------------------------------------
# AVANZADO
# -----------------------------------------------------------------------------

# Zona horaria para logs y timestamps
TZ=UTC

# Nombre de la red Docker interna
NETWORK_NAME=headscale-net

# Tag de la imagen de Headscale
HEADSCALE_IMAGE_TAG=latest

# Tag de la imagen de Headplane
HEADPLANE_IMAGE_TAG=latest

# Tag de la imagen de Caddy
CADDY_IMAGE_TAG=2-alpine
