# Caddyfile for Headscale + Headplane
# Generated by install.sh - DO NOT EDIT MANUALLY

${CADDY_DOMAIN} {
    # TLS configuration
    ${CADDY_TLS}

    # Logging
    log {
        output file /var/log/caddy/access.log
        format json
    }

    # Headers de seguridad
    header {
        # Habilitar HSTS (solo con SSL válido)
        ${CADDY_HSTS}

        # Prevenir clickjacking
        X-Frame-Options "SAMEORIGIN"

        # Prevenir MIME sniffing
        X-Content-Type-Options "nosniff"

        # XSS Protection
        X-XSS-Protection "1; mode=block"

        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Ocultar server header
        -Server
    }

    # Health check endpoint para monitoreo externo
    handle /healthz {
        respond "OK" 200
    }

    # Interfaz web de Headplane: sirve ÚNICAMENTE bajo /admin
    handle /admin* {
        reverse_proxy headplane:3000 {
            # Caddy ya envía X-Forwarded-{For,Proto,Host} por defecto
            header_up X-Real-IP {remote_host}
        }
    }

    # Todo lo demás pertenece a Headscale. Los clientes Tailscale usan la raíz
    # del dominio (/key, /ts2021, /machine/*, /derp, /bootstrap-dns, /windows,
    # /apple, /oidc/*, /api/*...), así que el control plane debe ser el destino
    # por defecto; enrutar sólo /api/* aquí dejaría la VPN inoperativa.
    handle {
        reverse_proxy headscale:${HEADSCALE_HTTP_PORT} {
            # Caddy ya envía X-Forwarded-{For,Proto,Host} por defecto
            header_up X-Real-IP {remote_host}
        }
    }
}

# Redirección de HTTP a HTTPS (solo si SSL habilitado)
${HTTP_REDIRECT}
