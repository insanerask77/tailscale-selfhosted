# Caddyfile for Headscale + Headplane
# Generated by install.sh - DO NOT EDIT MANUALLY

${CADDY_DOMAIN} {
    # TLS configuration
    ${CADDY_TLS}

    # Logging
    log {
        output file /var/log/caddy/access.log
        format json
    }

    # Headers de seguridad
    header {
        # Habilitar HSTS (solo con SSL válido)
        ${CADDY_HSTS}

        # Prevenir clickjacking
        X-Frame-Options "SAMEORIGIN"

        # Prevenir MIME sniffing
        X-Content-Type-Options "nosniff"

        # XSS Protection
        X-XSS-Protection "1; mode=block"

        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Ocultar server header
        -Server
    }

    # Reverse proxy a Headplane
    reverse_proxy headplane:3000 {
        # Health check
        health_uri /health
        health_interval 10s
        health_timeout 5s

        # Headers para WebSocket y SSE (si Headplane los usa)
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }

    # Proxy directo a Headscale API (opcional, para clientes que lo necesiten)
    handle /api/* {
        reverse_proxy headscale:${HEADSCALE_HTTP_PORT}
    }

    # Health check endpoint para monitoreo externo
    handle /healthz {
        respond "OK" 200
    }
}

# Redirección de HTTP a HTTPS (solo si SSL habilitado)
${HTTP_REDIRECT}
