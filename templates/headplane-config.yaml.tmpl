# Headplane configuration
# Generated by install.sh - DO NOT EDIT MANUALLY
# To reconfigure, run install.sh again or edit .env and regenerate

---
# Modo de integración con Headscale
# - integrated: acceso directo vía socket Unix (recomendado)
# - api: acceso vía HTTP API
integration:
  mode: ${INTEGRATION_MODE}

  # Configuración para modo integrated
  integrated:
    # Path al socket Unix de Headscale
    socket_path: /var/run/headscale/headscale.sock

    # Path al archivo de configuración de Headscale (lectura)
    config_path: /etc/headscale/config.yaml

  # Configuración para modo API (solo si mode=api)
  api:
    url: http://headscale:${HEADSCALE_HTTP_PORT}
    key: ${HEADSCALE_API_KEY}

# Configuración del servidor web
server:
  # Puerto de escucha
  port: 3000

  # Host de escucha (0.0.0.0 para todas las interfaces)
  host: 0.0.0.0

  # Base path (útil si se sirve desde un subdirectorio)
  base_path: /

# Configuración de sesiones
session:
  # Secreto para firmar cookies (OBLIGATORIO, 64 caracteres hex)
  secret: ${COOKIE_SECRET}

  # Nombre de la cookie
  name: headplane_session

  # Duración de la sesión (en horas)
  max_age: 168  # 7 días

  # Secure flag (true si se usa HTTPS)
  secure: ${SESSION_SECURE}

  # SameSite policy
  same_site: lax

# Autenticación
auth:
  # Tipo: local u oidc
  type: ${AUTH_TYPE}

  # Configuración local (usuario/contraseña)
  local:
    # Usuarios iniciales (se crean al primer inicio)
    # Después se gestionan desde la UI
    users: []

  # Configuración OIDC
  oidc:
    enabled: ${ENABLE_OIDC}
    issuer_url: ${OIDC_ISSUER_URL}
    client_id: ${OIDC_CLIENT_ID}
    client_secret: ${OIDC_CLIENT_SECRET}
    redirect_url: ${SERVER_URL}/auth/oidc/callback
    scopes:
      - ${OIDC_SCOPE}

    # Claims
    email_claim: ${OIDC_EMAIL_CLAIM}
    name_claim: name

    # Autorización adicional (opcional)
    # allowed_domains:
    #   - example.com
    # allowed_emails:
    #   - admin@example.com

# Logging
logging:
  level: ${LOG_LEVEL}
  format: json  # json o text

  # Log de accesos HTTP
  access_log: true

# UI customization (opcional)
ui:
  # Nombre de la organización mostrado en la UI
  organization_name: ${TAILNET_NAME}

  # Logo personalizado (URL)
  # logo_url: https://example.com/logo.png

  # Tema por defecto: light, dark, auto
  default_theme: auto

# Features flags
features:
  # Habilitar creación de usuarios desde la UI
  allow_user_registration: false

  # Habilitar API keys
  allow_api_keys: true

  # Habilitar edición de ACLs desde la UI
  allow_acl_editing: true

# Rate limiting
rate_limit:
  enabled: true
  requests_per_minute: 60
  burst: 10
