# Headplane configuration
# Generated by install.sh - DO NOT EDIT MANUALLY
# To reconfigure, run install.sh again or edit .env and regenerate

# Configuration for the Headplane server and web application
server:
  # Server listen address
  host: "0.0.0.0"
  port: 3000

  # The public base URL for Headplane itself (NOT Headscale's URL).
  # Must NOT include the /admin dashboard prefix.
  base_url: "${HEADPLANE_PUBLIC_URL}"

  # The secret used to encode and decode web sessions (32+ characters)
  cookie_secret: "${COOKIE_SECRET}"

  # Whether cookies should be marked as Secure
  # Should be true if running behind HTTPS
  cookie_secure: ${SESSION_SECURE}

  # The maximum age of the session cookie in seconds
  cookie_max_age: 604800 # 7 days

  # The path to persist Headplane specific data
  data_path: "/var/lib/headplane"

# Headscale specific settings to allow Headplane to talk to Headscale
headscale:
  # Internal URL used by Headplane for its own API calls (Docker network).
  # Not reachable from outside, so it must never be shown to end users.
  url: "http://headscale:${HEADSCALE_HTTP_PORT}"

  # Public URL of the control plane. This is what the Web UI displays in the
  # `tailscale up --login-server=...` command. Without it, Headplane would
  # advertise the internal Docker hostname above, which clients cannot resolve.
  public_url: "${HEADSCALE_PUBLIC_URL}"

  # Path to the Headscale configuration file (read-only access)
  # This is HIGHLY recommended for the best experience
  config_path: "/etc/headscale/config.yaml"

  # API key for server-side operations (required for OIDC and the agent).
  # Injected by install.sh after Headscale is up; empty on the first pass.
  ${HEADSCALE_API_KEY_LINE}

# Integration configurations for Headplane to interact with Headscale
integration:
  # Docker integration - for restarting Headscale when DNS settings change
  docker:
    enabled: true

    # Container label to identify the Headscale container
    container_label: "me.tale.headplane.target=headscale"

    # The path to the Docker socket
    socket: "unix:///var/run/docker.sock"

  # Agent integration (optional, for enhanced node information)
  agent:
    enabled: false

  # Kubernetes integration (not used in Docker deployments)
  kubernetes:
    enabled: false
    pod_name: "headscale"  # Required even when disabled

  # Proc integration (not used in Docker deployments)
  proc:
    enabled: false

# OIDC Configuration for SSO authentication (optional)
${OIDC_CONFIG_BLOCK}
