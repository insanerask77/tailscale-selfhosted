# =============================================================================
# Nginx - Control plane de Headscale
# Generado por install.sh - NO editar a mano
# =============================================================================
# Dominio : ${HEADSCALE_DOMAIN}
# Backend : ${BACKEND_HOST}:${HEADSCALE_HTTP_PORT}
#
# Este fichero es para un Nginx que gestionas tú. Si usas Nginx Proxy Manager,
# lee REVERSE-PROXY.md: allí sólo tienes que pegar el bloque "Advanced".
# =============================================================================

# IMPORTANTE: esta directiva va en el contexto http {}, no dentro de server {}.
# Sin ella, $connection_upgrade queda vacío y /ts2021 (que es un Upgrade de
# HTTP/1.1) falla, con lo que ningún cliente llega a establecer el túnel.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${HEADSCALE_DOMAIN};

    # Deja pasar el reto ACME antes de redirigir
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${HEADSCALE_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${HEADSCALE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${HEADSCALE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # El mapa de red que devuelve /machine/map no tiene tamaño acotado.
    client_max_body_size 0;
${HEADPLANE_LOCATION}
    location / {
        proxy_pass http://${BACKEND_HOST}:${HEADSCALE_HTTP_PORT};
        proxy_http_version 1.1;

        # /ts2021 negocia el canal Noise con un Upgrade de HTTP/1.1.
        # Nota: HTTP/2 prohíbe las cabeceras Upgrade/Connection, así que una
        # petición que llegue por h2 perdería el upgrade. No es un problema:
        # tailscaled fuerza HTTP/1.1 para /ts2021 justo por eso, y el resto
        # de rutas (y la UI) sí se benefician de h2.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect http:// https://;

        # CRÍTICO: /machine/map es un long-poll que se mantiene abierto
        # indefinidamente. Con el buffering activo Nginx acumula la respuesta y
        # los clientes nunca reciben las actualizaciones de la red; con el
        # timeout por defecto (60s) Nginx corta la conexión cada minuto y los
        # nodos entran en un ciclo de reconexión permanente.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
${CORS_BLOCK}
    }
}

# -----------------------------------------------------------------------------
# DERP / STUN (UDP ${HEADSCALE_DERP_PORT}) NO pasa por aquí.
# Nginx sólo hace proxy de HTTP; el relay embebido necesita UDP directo contra
# ${BACKEND_HOST}:${HEADSCALE_DERP_PORT}. Abre ese puerto en el firewall de la
# máquina de Headscale o desactiva el DERP embebido y usa el de Tailscale.
# -----------------------------------------------------------------------------
