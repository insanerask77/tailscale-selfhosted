# Headscale configuration
# Generated by install.sh - DO NOT EDIT MANUALLY
# To reconfigure, run install.sh again or edit .env and regenerate

---
# Server URL visible para los clientes
server_url: ${SERVER_URL}

# Direcciones de escucha
listen_addr: 0.0.0.0:${HEADSCALE_HTTP_PORT}
metrics_listen_addr: 0.0.0.0:${HEADSCALE_METRICS_PORT}

# gRPC configuración
grpc_listen_addr: 0.0.0.0:${HEADSCALE_GRPC_PORT}
grpc_allow_insecure: false

# Rangos de IP para los clientes
prefixes:
  v4: ${IP_PREFIXES_V4}
  v6: ${IP_PREFIXES_V6}
  allocation: sequential

# DERP (Designated Encrypted Relay for Packets)
derp:
  # Server list URL (puedes usar la lista pública de Tailscale o tu propia lista)
  urls:
    - https://controlplane.tailscale.com/derpmap/default

  # Servidor DERP embebido (opcional, para redes privadas)
  server:
    enabled: true
    region_id: 999
    region_code: "custom"
    region_name: "Custom Embedded DERP"
    stun_listen_addr: "0.0.0.0:${HEADSCALE_DERP_PORT}"
    # Clave privada para el servidor DERP
    private_key_path: /var/lib/headscale/derp_server_private.key
    # Activar auto-detección de IP pública
    automatically_add_embedded_derp_region: true

  # Auto-actualizar lista de servidores DERP
  auto_update_enabled: true
  update_frequency: 24h

# Configuración de rutas privadas
private_key_path: /var/lib/headscale/private.key

# Noise protocol (nueva versión de Tailscale/Headscale)
noise:
  private_key_path: /var/lib/headscale/noise_private.key

# Database (SQLite por defecto)
database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true

# Para PostgreSQL, comenta sqlite y descomenta esto:
# database:
#   type: postgres
#   postgres:
#     host: postgres
#     port: 5432
#     name: headscale
#     user: headscale
#     pass: ${DB_PASSWORD}
#     max_open_conns: 10
#     max_idle_conns: 10
#     conn_max_idle_time_secs: 3600

# Policy (ACL)
policy:
  # Path al archivo de ACL policy (vacío = política permisiva por defecto)
  path: ""

# DNS configuration
dns:
  # Usar MagicDNS
  magic_dns: true

  # Base domain para MagicDNS (FQDN sin punto final)
  base_domain: ${TAILNET_NAME}.headscale.net

  # Nameservers para los clientes
  nameservers:
    global:
      - 1.1.1.1
      - 1.0.0.1

  # Dominios de búsqueda
  search_domains: []

  # Split DNS (opcional)
  extra_records: []

# Log
log:
  format: text
  level: ${LOG_LEVEL}

# Unix socket para comunicación local (usado por Headplane en modo integrated)
unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

# OIDC (opcional, descomentado si ENABLE_OIDC=true)
${OIDC_CONFIG}

# Configuración de nodos
node:
  # Timeout de inactividad para nodos efímeros
  ephemeral:
    inactivity_timeout: 30m

  # Intervalo de verificación de actualizaciones de nodos
  update_check_interval: 10s

# CLI
cli:
  # Timeout para comandos CLI
  timeout: 5s
  # Insecure: permite CLI sin TLS (solo para desarrollo)
  insecure: false
